<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShellGame.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShellGame.Views"
    xmlns:local="clr-namespace:ShellGame"
    Title="ShellGame"
    FlowDirection="RightToLeft">
    <FlyoutItem Title="דף אחד">
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:Page1}"
        Route="MainPage" />
    </FlyoutItem>
    <FlyoutItem Title="דף שני">
        <ShellContent
            Title="Page 2"
            ContentTemplate="{DataTemplate views:NewPage2}"
            Route="NewPage2" />
    </FlyoutItem>
    
</Shell>
