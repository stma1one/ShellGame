<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShellGame.Views.NewPage3"
             xmlns:views="clr-namespace:ShellGame.Views"
             x:DataType="views:NewPage3"
             Title="NewPage3">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to Page 3" FontSize="55"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
      
        <Label Text="{Binding MessageFromPage2 }" TextColor="Red" FontSize="55"/>
        <Label Text="{Binding Message2 }" TextColor="Red" FontSize="55"/>
        <Label Text="{Binding Student.Name}" FontSize="55" TextColor="Green"/>
    </VerticalStackLayout>
</ContentPage>